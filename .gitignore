# Nothing in this repository should ever contain a working credential. These
# patterns are the backstop for the local files a deployment tends to produce.
# See SECRETS.md.
*/secret.yaml
*/secrets.yaml
.env
*.env

# Real values belong outside the repository, or in a file matched here.
values.local.yaml
values.*.local.yaml
*-values.yaml

# Helm
*.tgz
charts/

# Editors / OS
.DS_Store
*.swp
